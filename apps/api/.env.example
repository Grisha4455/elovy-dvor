# Обязательно: случайная строка от 32 символов (openssl rand -hex 32)
JWT_SECRET=

PORT=4000
DB_PATH=./data/elovy-dvor.db
# Адрес сайта: с других origin запросы, меняющие данные, отклоняются
WEB_ORIGIN=http://localhost:5173

# AI-администратор (https://platform.claude.com). Без ключа чат отвечает «не настроен».
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# Telegram-уведомления владельцу. Без них заявки видны только в админке.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Случайная строка от 16 символов, Telegram присылает её в каждом запросе webhook
TELEGRAM_WEBHOOK_SECRET=
