{
  "name": "elovy-dvor",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @elovy-dvor/api & npm run dev -w @elovy-dvor/web",
    "seed": "npm run seed -w @elovy-dvor/api",
    "test": "npm test -w @elovy-dvor/api",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
